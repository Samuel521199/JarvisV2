{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:step-proposal:v1",
  "title": "Jarvis step-proposal v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "jarvis.step-proposal.v1"
    },
    "kind": {
      "type": "string",
      "enum": [
        "tool",
        "finish",
        "wait"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,79}"
    },
    "arguments": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 50000
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,79}"
        },
        "content": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60000
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "kind",
    "reason"
  ],
  "additionalProperties": false
}
