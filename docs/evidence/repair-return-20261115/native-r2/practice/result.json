        "content": "import json\n\ndef run(text: str) -> str:\n    data = json.loads(text)\n    pairs = data.get(\"pairs\", [])\n    exercises = []\n    for pair in pairs:\n        a, b = pair[0], pair[1]\n        exercises.append({\n            \"a\": a,\n            \"b\": b,\n            \"answer\": a * b,\n        })\n    result = {\n        \"exercises\": exercises,\n        \"schema\": \"jarvis.practice-result.v1\",\n    }\n    return json.dumps(result, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"))\n",
