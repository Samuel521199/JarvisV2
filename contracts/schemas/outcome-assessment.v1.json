{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "jarvis.outcome-assessment.v1"
    },
    "id": {
      "type": "string",
      "maxLength": 160
    },
    "task_id": {
      "type": "string",
      "maxLength": 160
    },
    "fingerprint": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1
    },
    "goal_id": {
      "type": "string",
      "maxLength": 160
    },
    "goal_revision": {
      "type": "integer",
      "minimum": 0
    },
    "evaluator": {
      "type": "string",
      "const": "deterministic-1.0.0"
    },
    "execution_status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "PARTIAL",
        "ISSUES",
        "INVALIDATED"
      ]
    },
    "score": {
      "type": "null"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "unknown",
              "invalid"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 160
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          }
        },
        "required": [
          "id",
          "status",
          "reason",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "maxLength": 160
          },
          "digest": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "ref",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "known": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        }
      },
      "required": [
        "total",
        "known",
        "passed"
      ],
      "additionalProperties": false
    },
    "source_status": {
      "type": "string",
      "enum": [
        "current",
        "invalid",
        "unknown"
      ]
    },
    "assessed_at": {
      "type": "number",
      "minimum": 0
    },
    "supersedes": {
      "type": "string",
      "maxLength": 160
    }
  },
  "required": [
    "schema",
    "id",
    "task_id",
    "fingerprint",
    "task_revision",
    "goal_id",
    "goal_revision",
    "evaluator",
    "execution_status",
    "state",
    "score",
    "criteria",
    "evidence",
    "coverage",
    "source_status",
    "assessed_at",
    "supersedes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis:outcome-assessment:v1",
  "description": "Read-only deterministic evidence; score remains null until a complete quality rubric exists."
}
