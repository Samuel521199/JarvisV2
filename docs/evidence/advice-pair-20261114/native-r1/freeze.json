  "tools": {
    "comparison": {
      "capability": "plugin.advice-quote.v1",
      "description": "Read jarvis.quote-input.v1 JSON. Filter by current max_price_minor AND max_delivery_days, then select lowest eligible price. Return JSON eligible_ids, selected_id and selected_source; null if none. No network.",
      "code": "import json\ndef run(text):\n    x=json.loads(text)\n    eligible=[o for o in x['offers'] if o['price_minor']<=x['max_price_minor'] and o['delivery_days']<=x['max_delivery_days']]\n    chosen=min(eligible,key=lambda o:o['price_minor']) if eligible else None\n    return json.dumps({'eligible_ids':sorted(o['id'] for o in eligible),'selected_id':chosen['id'] if chosen else None,'selected_source':chosen['source'] if chosen else None},ensure_ascii=False,sort_keys=True,separators=(',',':'))\n",
      "sample": {
        "schema": "jarvis.quote-input.v1",
        "currency": "CNY",
        "max_price_minor": 100,
        "max_delivery_days": 2,
        "offers": [
          {
            "id": "sample",
            "price_minor": 80,
            "delivery_days": 1,
            "source": "sample-only"
          }
        ]
      },
      "expected": {
        "eligible_ids": [
          "sample"
        ],
        "selected_id": "sample",
        "selected_source": "sample-only"
      }
    },
    "documents": {
      "capability": "plugin.advice-notes.v1",
      "description": "Read jarvis.notes-input.v1 JSON sources array of {id,text}; emit jarvis.notes-result.v1 JSON with excerpts preserving every source id/text byte-for-byte and in order. Do not paraphrase or invent facts.",
      "code": "import json\ndef run(text):\n    x=json.loads(text)\n    return json.dumps({'schema':'jarvis.notes-result.v1','excerpts':x['sources']},ensure_ascii=False,sort_keys=True,separators=(',',':'))\n",
      "sample": {
        "schema": "jarvis.notes-input.v1",
        "sources": [
          {
            "id": "s",
            "text": "Sample excerpt."
          }
        ]
      },
      "expected": {
        "schema": "jarvis.notes-result.v1",
        "excerpts": [
          {
            "id": "s",
            "text": "Sample excerpt."
          }
        ]
      }
    },
    "learning": {
      "capability": "plugin.advice-practice.v1",
      "description": "Read jarvis.practice-input.v1 JSON pairs array of two positive integers; emit jarvis.practice-result.v1 with exercises {a,b,answer} using current multiplication products. Produce a practice worksheet only; no claim the learner mastered it.",
      "code": "import json\ndef run(text):\n    x=json.loads(text)\n    return json.dumps({'schema':'jarvis.practice-result.v1','exercises':[{'a':p[0],'b':p[1],'answer':p[0]*p[1]} for p in x['pairs']]},ensure_ascii=False,sort_keys=True,separators=(',',':'))\n",
      "sample": {
