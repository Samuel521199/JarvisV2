flowchart TB
  A["新消息 / 资料变化 / 实际任务结果"] --> B{"允许保存？"}
  B -->|"否"| TEMP["仅当前使用<br/>不进入长期整理队列"]
  B -->|"是"| RAW["登记原件与事件<br/>来源 · 范围 · 版本"]
  RAW --> Q["后台去重与排队<br/>前台已可继续交流"]
  Q --> C["规则或模型提取候选<br/>主张 · 依据 · 适用条件"]
  C --> V{"来源有效且符合晋升规则？"}
  V -->|"含糊 / 矛盾"| WAIT["待核对或隔离<br/>保留问题与原因"]
  WAIT -->|"补充证据"| V
  V -->|"有效"| F["单次事务提交<br/>事实修订 + 派生更新事件"]
  F --> I["增量索引 / 主题知识<br/>失败可重试，记录水位"]
  I --> R["读取时复核范围与当前修订<br/>只引用已打开的有效证据"]
  R --> O["回答 / 计划 / 受控执行"]
  O -->|"真实效果与纠正"| A
  X["主人纠正 / 遗忘 / 权限撤回"] --> INVALID["立即停止后续使用<br/>待提交候选重新核验"]
  INVALID --> CLEAN["按依赖清理正文与派生副本<br/>索引 · 缓存 · 任务背景 · 分享队列"]
  CLEAN --> ACK["逐项回执<br/>离线设备 / 备份 / 外发副本边界可见"]
  INVALID -. "迟到候选不得复活" .-> V
  INVALID -. "旧结果不得继续使用" .-> R
  UPGRADE["组件升级 / 换机 / 恢复"] --> SHADOW["影子转换与重建<br/>先应用最新撤销，再验证"]
  SHADOW -->|"验收通过并追平水位"| I
  SHADOW -->|"失败"| KEEP["保留当前可用版本<br/>事实与撤销不回滚"]
  classDef store fill:#e8f2ff,stroke:#537fa1,color:#17354a;
  classDef change fill:#fff1da,stroke:#ad8245,color:#49341d;
  class RAW,F,I store;
  class X,INVALID,CLEAN,ACK,SHADOW change;
