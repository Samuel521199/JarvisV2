{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "jarvis.code-candidate.v1"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70,
            "pattern": "[a-z][a-z0-9_]{0,40}\\.py"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40000
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 8
    }
  },
  "required": [
    "schema",
    "summary",
    "files"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
