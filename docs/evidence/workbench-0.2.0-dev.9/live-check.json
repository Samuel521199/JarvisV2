    "package_id": "pkg-f7e2e9121abed0d97ea951985735d2f4682c1eb66fd6d53d395f3108b7dc78a5",
    "candidate": {
      "files": [
        {
          "content": "import json\n\ndef run(text: str) -> str:\n    total = 0\n    done = 0\n    pending = 0\n    remaining = []\n\n    if text:\n        for raw_line in text.splitlines():\n            line = raw_line.strip()\n            if line.startswith(\"- [x]\") or line.startswith(\"- [X]\"):\n                title = line[5:].strip()\n                if title:\n                    total += 1\n                    done += 1\n            elif line.startswith(\"- [ ]\"):\n                title = line[5:].strip()\n                if title:\n                    total += 1\n                    pending += 1\n                    remaining.append(title)\n\n    result = {\n        \"total\": total,\n        \"done\": done,\n        \"pending\": pending,\n        \"remaining\": remaining,\n    }\n    return json.dumps(result, ensure_ascii=False, separators=(\",\", \":\"))\n",
          "path": "main.py"
        }
      ],
      "schema": "jarvis.code-candidate.v1",
      "summary": "实现 run 函数解析待办清单文本，统计完成及未完成待办并输出紧凑 JSON 格式。"
    },
