      {
        "content": "import json\n\ndef run(text: str) -> str:\n    data = json.loads(text)\n    max_price = data.get(\"max_price_minor\")\n    max_days = data.get(\"max_delivery_days\")\n    offers = data.get(\"offers\", [])\n\n    eligible_ids = []\n    cheapest_offer = None\n\n    for offer in offers:\n        price = offer.get(\"price_minor\")\n        delivery = offer.get(\"delivery_days\")\n        if price is not None and delivery is not None and max_price is not None and max_days is not None:\n            if price <= max_price and delivery <= max_days:\n                eligible_ids.append(offer.get(\"id\"))\n                if cheapest_offer is None or price < cheapest_offer.get(\"price_minor\"):\n                    cheapest_offer = offer\n\n    result = {\n        \"eligible_ids\": eligible_ids,\n        \"schema\": \"jarvis.quote-result.v1\",\n        \"selected_id\": cheapest_offer.get(\"id\") if cheapest_offer else None,\n        \"selected_source\": cheapest_offer.get(\"source\") if cheapest_offer else None,\n    }\n\n    return json.dumps(result, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"))\n",
        "path": "main.py"
      }
