flowchart TB
  IN["文字 / 语音 / 资料 / 回执"] --> SCOPE["本轮请求视图<br/>身份 · 用途 · 项目与分支 · 目的地"]
  SCOPE --> READ["按需检索与证据复核<br/>结构字段 → 词项/向量 → 原件章节"]
  READ --> PACK["有界上下文<br/>当前事实 · 引用 · 冲突与缺口"]
  PACK --> CHAT["前台交流<br/>聊天 · 情感表达 · 澄清"]
  PACK --> PLAN["任务规划与能力选择<br/>实际契约 · 权限 · 资源预算"]
  SELF["自身能力目录与任务账本<br/>声明 / 观察 / 验证分别记录"] --> PLAN
  PLAN --> RUN["Tools / Skills / 按需 Agent<br/>任务专属上下文 · 独立取消"]
  RUN --> RESULT["核验实际效果<br/>结果回原会话 · 经验候选"]
  IN -->|"允许保存"| RAW["原始资料与经历<br/>作者 · 时间 · 版本 · 片段"]
  RAW --> BG["低优先级后台整理<br/>候选核验 · 冲突检查 · 按规则晋升"]
  RESULT --> BG
  BG --> FACT["本地事实权威 SQLite<br/>范围 · 修订 · 使用许可 · 撤销"]
  FACT --> INDEX["可重建的知识与索引<br/>章节 · 词项 · 向量 · 关系"]
  FACT --> READ
  INDEX --> READ
  RAW -. "需要时回查" .-> READ
  PRIV["私密域：加密与解锁<br/>成员及输出渠道分别许可"] -. "限制读取和外发" .-> SCOPE
  FACT <-->|"允许的事件；不重放动作"| SYNC["设备共享<br/>先撤销对账，再接收与重建"]
  classDef data fill:#e8f2ff,stroke:#537fa1,color:#17354a;
  classDef gate fill:#fff1da,stroke:#ad8245,color:#49341d;
  class RAW,FACT,INDEX,SELF data;
  class SCOPE,PACK,PRIV,SYNC gate;
