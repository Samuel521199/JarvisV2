{
  "id": "studio3d",
  "name": "3D 工作室",
  "version": "1.4.0",
  "kind": "composite-skill-plugin",
  "source": {
    "adapter": "Jarvis first-party independent implementation",
    "engine": "https://www.blender.org/",
    "engine_license": "GPL-2.0-or-later",
    "reference_only": "https://github.com/ahujasid/blender-mcp",
    "copied_upstream_code": false,
    "viewer_engine": "https://github.com/mrdoob/three.js",
    "format_validator": "https://github.com/KhronosGroup/glTF-Validator"
  },
  "use_when": [
    "editable curved 3D mesh",
    "PBR material and physically based still rendering",
    "licensed GLB asset studio rendering"
  ],
  "do_not_use_when": [
    "mechanical accuracy or manufacturing CAD certification",
    "real CFD/combustion/contact simulation",
    "promise automatic AAA production acceptance"
  ],
  "components": [
    "bounded geometry",
    "materials",
    "studio lighting",
    "Cycles/EEVEE",
    "GLB/BLEND/PNG export",
    "roundtrip checks",
    "interactive PBR inspection",
    "actual texture inventory",
    "static atlas material baking",
    "three static LODs",
    "topology checks and sampled surface distances",
    "Khronos glTF-Validator",
    "bounded local reference PNG and provenance",
    "five orthographic camera renders",
    "flat or smooth mesh shading",
    "bounded exposure",
    "2K atlas option",
    "tracked vehicle visual study with named semantic groups",
    "vehicle/machine/hard-surface prop production profiles",
    "high master to per-part low mesh projection",
    "sampled projection-ray coverage and explicit triangle budgets",
    "rigid part names and origins retained without rigging certification",
    "explicit PNG-to-Gemini bounded scene planning",
    "organic radial surfaces and fruit/bark appearance",
    "scale-aware camera framing and 1000-triangle organic profile"
  ],
  "policy": {
    "enabled_by_default": true,
    "explicit_execution": true,
    "model_route": "existing Jarvis dialogue lane",
    "no_generated_code_execution": true,
    "no_automatic_replay": true
  },
  "runtime": "modules/skills/studio3d/runtime.json",
  "acceptance": "docs/delivery-validation.md#studio3d-evidence",
  "learning": {
    "version": "1.0.0",
    "handbook": "docs/studio3d-learning.md",
    "host": "host/studio3d_learning.py",
    "methods": "modules/skills/studio3d/experience-cards.json",
    "status": "verified for two fixed tools and diagnostic coupons; full art practice and transfer gains pending",
    "tools": [
      "remove_rejected",
      "seat_attachment"
    ],
    "automatic_promotion": false
  }
}
