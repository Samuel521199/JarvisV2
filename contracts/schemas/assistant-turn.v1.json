{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "jarvis.assistant-turn.v1"
    },
    "reply": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "action": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "chat",
            "goal",
            "amend",
            "cancel",
            "resume",
            "commitment"
          ]
        },
        "goal": {
          "type": "string",
          "maxLength": 4000
        },
        "input_text": {
          "type": "string",
          "maxLength": 12000
        },
        "target": {
          "type": "string",
          "maxLength": 60
        },
        "commitment": {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "enum": [
                "create",
                "reschedule",
                "cancel",
                "complete"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "due_at": {
              "type": "string",
              "maxLength": 40
            },
            "time_text": {
              "type": "string",
              "maxLength": 120
            },
            "basis_turn": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": [
            "operation",
            "title",
            "quote",
            "due_at",
            "time_text",
            "basis_turn"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "goal",
        "input_text",
        "target"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "reply",
    "action"
  ],
  "additionalProperties": false
}
